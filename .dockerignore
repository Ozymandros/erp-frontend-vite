# Dependencies (reinstalled in the image)
node_modules
.pnpm-store

# Build outputs
dist
dist-ssr
*.local

# Coverage and test artifacts (not needed to build)
coverage
junit.xml
playwright-report
test-results
.scannerwork

# Version control
.git
.gitignore
.gitattributes

# Environment and secrets — never bake into the image
.env
.env.*
!.env.example

# CI, agents, and local dev tooling
.github
.devcontainer
.cursor
.agents
.agent
.husky

# Documentation (not required for production build)
docs
*.md
!README.md

# IDE and editor
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
.DS_Store
Thumbs.db

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Playwright browsers and E2E-only config (src/test/e2e stays for tsc)
playwright.config.ts
playwright/.cache

# Docker build context (avoid recursive copy)
Dockerfile*
docker-compose*.yml
docker-compose*.yaml
